# Day 2 simple/ path: hosted Groq LLM + local multilingual embeddings.
# Create your key at https://console.groq.com/keys. Never commit .env.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
DATA_PATH=data/saudi_vision2030_ar.txt
ARTIFACTS_DIR=artifacts

